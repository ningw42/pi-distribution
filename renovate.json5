{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["npm", "custom.regex"],
  "baseBranchPatterns": ["master"],
  "branchPrefix": "renovate/",
  "branchTopic": "dependencies",
  "rangeStrategy": "pin",
  "dependencyDashboard": false,
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "ignoreTests": false,
  "rebaseWhen": "behind-base-branch",
  "branchConcurrentLimit": 1,
  "prConcurrentLimit": 1,
  "prHourlyLimit": 1,
  "lockFileMaintenance": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^vendor\\/pi-rtk\\/metadata\\.json$/"],
      "matchStrings": ["\"upstreamRepository\": \"rtk-ai/rtk\",\\s*\"version\": \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "rtk-ai/rtk",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)$",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Disable npm metadata that pi-distribution does not update",
      "matchManagers": ["npm"],
      "matchDepTypes": ["optionalDependencies", "peerDependencies", "packageManager"],
      "enabled": false
    },
    {
      "description": "Group exact npm and generated RTK updates behind required cross-platform CI",
      "matchManagers": ["npm", "custom.regex"],
      "rangeStrategy": "pin",
      "groupName": "dependencies",
      "groupSlug": "dependencies",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "labels": ["auto-release:dependencies"]
    }
  ]
}
