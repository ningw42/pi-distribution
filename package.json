{
  "name": "pi-distribution",
  "version": "0.1.0",
  "description": "An aggregate package of Pi extensions, skills, and themes",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "files": [
    "extensions",
    "vendor",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "check": "node scripts/check-package.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:package": "npm run test:unit && npm run check",
    "test:runtime": "node --test \"tests/runtime/*.test.mjs\"",
    "test": "npm run test:package && npm run test:runtime",
    "test:all": "npm test && npm run smoke",
    "smoke": "node scripts/smoke-test.mjs",
    "update:pi-rtk": "node scripts/update-pi-rtk.mjs"
  },
  "dependencies": {
    "@everyx/pi-status-line": "1.0.5",
    "@juicesharp/rpiv-ask-user-question": "2.13.9",
    "@juicesharp/rpiv-btw": "2.13.9",
    "@pwguler/pi-loop": "0.8.2",
    "@quintinshaw/pi-dynamic-workflows": "3.14.0",
    "@sherif-fanous/pi-catppuccin": "0.3.0",
    "@thinkscape/pi-status": "0.3.6",
    "@tifan/pi-inline-skills": "1.0.7",
    "@tintinweb/pi-subagents": "0.22.0",
    "@tintinweb/pi-tasks": "0.9.1",
    "pi-cc-extensions": "1.0.9",
    "pi-input-history": "1.1.3",
    "pi-theme-picker": "0.1.2"
  },
  "bundleDependencies": [
    "@everyx/pi-status-line",
    "@pwguler/pi-loop",
    "@quintinshaw/pi-dynamic-workflows",
    "@thinkscape/pi-status",
    "@tifan/pi-inline-skills",
    "@tintinweb/pi-subagents",
    "@tintinweb/pi-tasks",
    "@juicesharp/rpiv-ask-user-question",
    "@juicesharp/rpiv-btw",
    "@sherif-fanous/pi-catppuccin",
    "pi-cc-extensions",
    "pi-input-history",
    "pi-theme-picker"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./extensions/pi-rtk/index.ts",
      "./extensions/pi-statusline/index.ts",
      "./extensions/pi-status/index.ts",
      "./extensions/rpiv-ask-user-question/index.ts",
      "./extensions/rpiv-btw/index.ts",
      "./extensions/pi-cc-extensions/index.ts",
      "./extensions/pi-dynamic-workflows/index.ts",
      "./extensions/pi-inline-skills/index.ts",
      "./extensions/pi-input-history/index.ts",
      "./extensions/pi-loop/index.ts",
      "./extensions/pi-theme-picker/index.ts",
      "./extensions/pi-subagents/index.ts",
      "./extensions/pi-tasks/index.ts"
    ],
    "skills": [
      "./node_modules/@quintinshaw/pi-dynamic-workflows/skills/workflow-authoring",
      "./node_modules/@quintinshaw/pi-dynamic-workflows/skills/workflow-patterns"
    ],
    "themes": [
      "./node_modules/pi-cc-extensions/themes",
      "./node_modules/@sherif-fanous/pi-catppuccin/themes"
    ]
  },
  "packageManager": "npm@11.16.0"
}
