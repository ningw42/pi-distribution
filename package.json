{
  "name": "pi-distribution",
  "version": "0.1.0",
  "description": "An aggregate package of Pi extensions, skills, and themes",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "files": [
    "extensions",
    "vendor",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "check": "node scripts/check-package.mjs",
    "test": "node --test tests/*.test.mjs && npm run check",
    "smoke": "node scripts/smoke-test.mjs",
    "update:pi-rtk": "node scripts/update-pi-rtk.mjs"
  },
  "dependencies": {
    "@juicesharp/rpiv-ask-user-question": "2.7.1",
    "@juicesharp/rpiv-btw": "2.7.1",
    "@quintinshaw/pi-dynamic-workflows": "3.7.0",
    "@sherif-fanous/pi-catppuccin": "0.2.0",
    "@thinkscape/pi-status": "0.3.6",
    "@tifan/pi-inline-skills": "1.0.5",
    "@tintinweb/pi-subagents": "0.18.1",
    "@tintinweb/pi-tasks": "0.9.0",
    "pi-cc-extensions": "0.8.67",
    "pi-mcp-adapter": "2.27.0",
    "pi-theme-picker": "0.1.2"
  },
  "bundleDependencies": [
    "@quintinshaw/pi-dynamic-workflows",
    "@thinkscape/pi-status",
    "@tifan/pi-inline-skills",
    "@tintinweb/pi-subagents",
    "@tintinweb/pi-tasks",
    "@juicesharp/rpiv-ask-user-question",
    "@juicesharp/rpiv-btw",
    "@sherif-fanous/pi-catppuccin",
    "pi-cc-extensions",
    "pi-mcp-adapter",
    "pi-theme-picker"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./extensions/pi-rtk/index.ts",
      "./extensions/pi-statusline/index.ts",
      "./extensions/pi-status/index.ts",
      "./extensions/rpiv-ask-user-question/index.ts",
      "./extensions/rpiv-btw/index.ts",
      "./extensions/pi-cc-extensions/index.ts",
      "./extensions/pi-dynamic-workflows/index.ts",
      "./extensions/pi-inline-skills/index.ts",
      "./extensions/pi-mcp-adapter/index.ts",
      "./extensions/pi-theme-picker/index.ts",
      "./extensions/pi-subagents/index.ts",
      "./extensions/pi-tasks/index.ts"
    ],
    "skills": [
      "./node_modules/@quintinshaw/pi-dynamic-workflows/skills/workflow-authoring",
      "./node_modules/@quintinshaw/pi-dynamic-workflows/skills/workflow-patterns",
      "./node_modules/pi-mcp-adapter/skills/mcp-scripting"
    ],
    "themes": [
      "./node_modules/pi-cc-extensions/themes",
      "./node_modules/@sherif-fanous/pi-catppuccin/themes"
    ]
  },
  "packageManager": "npm@11.16.0"
}
